// Niri config - migrated from Hyprland (~/.config/hypr/hyprland.conf)
// Mod = Super (on TTY), Alt (when nested)

// ── Environment ──
environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    NVD_BACKEND "direct"
    QT_QPA_PLATFORM "wayland"
    __GL_GSYNC_ALLOWED "0"
    __GL_VRR_ALLOWED "0"
    __NV_PRIME_RENDER_OFFLOAD "0"
    __GLX_VENDOR_LIBRARY_NAME "mesa"
    LIBVA_DRIVER_NAME "iHD"
    QT_STYLE_OVERRIDE "adwaita-dark"
}

cursor {
    xcursor-size 24
}

// ── Startup ──
spawn-at-startup "ghostty"
spawn-sh-at-startup "wl-paste --watch cliphist store"
spawn-at-startup "udiskie"
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"
spawn-sh-at-startup "qs -c noctalia-shell -d"
spawn-sh-at-startup "/home/xevrion/.local/bin/hypr-display-toggle guard"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"
spawn-at-startup "vicinae" "server"

// ── Input ──
input {
    keyboard {
        numlock
    }

    touchpad {
        tap
        natural-scroll
        drag true
        click-method "clickfinger"
    }

    mouse {
        accel-speed -0.2
        accel-profile "flat"
    }

    focus-follows-mouse
}

// ── Outputs ──
output "HDMI-A-1" {
    mode "2560x1440@144"
    position x=0 y=0
    scale 1
    variable-refresh-rate on-demand=true
}

output "eDP-1" {
    mode "1920x1080@144"
    position x=2560 y=0
    scale 1
    variable-refresh-rate on-demand=true
}

// ── Workspace → Output Assignment ──
workspace "1" { open-on-output "HDMI-A-1"; }
workspace "2" { open-on-output "HDMI-A-1"; }
workspace "3" { open-on-output "HDMI-A-1"; }
workspace "4" { open-on-output "HDMI-A-1"; }
workspace "5" { open-on-output "HDMI-A-1"; }
workspace "6" { open-on-output "eDP-1"; }
workspace "7" { open-on-output "eDP-1"; }
workspace "8" { open-on-output "eDP-1"; }
workspace "9" { open-on-output "eDP-1"; }
workspace "10" { open-on-output "eDP-1"; }

// Named workspaces replicating Hyprland's special:scratchpad & special:magic
workspace "scratchpad"
workspace "magic"

// ── Layout ──
layout {
    gaps 12

    focus-ring {
        width 4
        active-color "#b4beff"
        inactive-color "#45475a"
    }

    border {
        off
    }

    shadow {
        off
    }

    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
}

// ── Screenshots ──
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ── Animations ──
animations {}

// ── Blur ──
blur {
    passes 4
    offset 3.0
    noise 0.03
    saturation 1.0
}

prefer-no-csd

// ── Hotkey Overlay ──
hotkey-overlay { skip-at-startup; }

// ── Window Rules ──

// WezTerm fix
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox PiP
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// voiceflow-overlay (floating overlay)
window-rule {
    match title="voiceflow-overlay"
    open-floating true
    open-focused false
}

// Recordly HUD
window-rule {
    match title=r#"^(Recordly HUD)$"#
    open-floating true
    open-focused false
    shadow { off; }
}

// Comnyang desktop pet
window-rule {
    match app-id=r#"^(comnyang)$"#
    open-floating true
    geometry-corner-radius 0
    clip-to-geometry true
}

// Ghostty: let the focus ring draw without a background box
window-rule {
    match app-id="ghostty"
    draw-border-with-background false
}

// No focus ring on floating windows
window-rule {
    match is-floating=true
    focus-ring { off; }
}


// Rounded corners (matching Hyprland decoration.rounding = 10)
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// ── Layer Rules ──

layer-rule {
    match namespace="^vicinae$"
    background-effect { blur true; xray false; }
}

layer-rule {
    match namespace="^noctalia-overview"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(launcher-overlay|dock)-"
    background-effect { blur true; xray false; }
}

// ── Key Bindings ──
binds {
    // ── Info ──
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ── Overview ──
    Mod+Tab repeat=false { toggle-overview; }

    // ── Apps ──
    Mod+A { spawn "ghostty"; }
    Mod+O { spawn-sh "qs -c noctalia-shell ipc call launcher toggle"; }
    Mod+Space { spawn-sh "vicinae toggle"; }
    Mod+E { spawn "nautilus"; }
    Mod+X { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
    Mod+N { spawn-sh "qs -c noctalia-shell ipc call notifications toggleHistory"; }
    Mod+Comma { spawn-sh "qs -c noctalia-shell ipc call settings toggle"; }
    Mod+C { spawn-sh "qs -c noctalia-shell ipc call controlCenter toggle"; }
    Mod+V { spawn-sh "qs -c noctalia-shell ipc call launcher clipboard"; }
    Mod+Shift+N { spawn-sh "qs -c noctalia-shell ipc call nightLight toggle"; }
    Mod+W { spawn-sh "qs -c noctalia-shell ipc call wallpaper random \"\""; }
    Mod+F10 { spawn-sh "/home/xevrion/.local/bin/hypr-display-toggle toggle"; }

    // ── Lock ──
    Mod+Alt+L { spawn "hyprlock"; }

    // ── Screenshots ──
    Print { spawn-sh "f=~/Pictures/$(date +'%Y-%m-%d_%H-%M-%S').png && grim -g \"$(slurp-persistent)\" \"$f\" && wl-copy < \"$f\""; }
    Shift+Print { spawn-sh "f=~/Pictures/$(date +'%Y-%m-%d_%H-%M-%S').png && grim -g \"$(slurp-persistent --last)\" \"$f\" && wl-copy < \"$f\""; }
    Mod+Print { spawn-sh "grim - | wl-copy"; }
    Mod+S { spawn-sh "/home/xevrion/.local/bin/shot-window"; }
    Mod+Grave { spawn-sh "/home/xevrion/.local/bin/shot-region"; }

    // ── Color Picker ──
    Mod+Shift+C { spawn-sh "hyprpicker -a"; }

    // ── Volume / Media / Brightness ──
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume increase"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume decrease"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume muteOutput"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media playPause"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media next"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media pause"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media play"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness increase"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness decrease"; }
    XF86Calculator { spawn "gnome-calculator"; }

    // ── Window Ops ──
    Mod+Q { close-window; }
    Mod+Shift+Q { quit; }
    Mod+T { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+B { toggle-column-tabbed-display; }
    Mod+F { fullscreen-window; }
    Mod+Shift+F { maximize-column; }
    // ── Focus Navigation ──
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }

    // ── Move Windows in Tiling ──
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // ── Column Edges ──
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // ── Move Window Between Monitors ──
    // Hyprland: Super+Shift+arrows → movewindow mon:-1/+1
    Mod+Shift+Left  { move-column-to-monitor-left; }
    Mod+Shift+Right { move-column-to-monitor-right; }
    Mod+Shift+Up    { move-column-to-monitor-up; }
    Mod+Shift+Down  { move-column-to-monitor-down; }

    // ── Workspace Switching ──
    Mod+Page_Down  { focus-workspace-down; }
    Mod+Page_Up    { focus-workspace-up; }
    Mod+U          { focus-workspace-down; }
    Mod+I          { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U    { move-column-to-workspace-down; }
    Mod+Ctrl+I    { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U   { move-workspace-down; }
    Mod+Shift+I   { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // ── By Index ──
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }

    // ── Named (Special) Workspaces ──
    Mod+Shift+S { move-column-to-workspace "magic"; }
    Mod+Shift+Grave { move-column-to-workspace "scratchpad"; }

    // ── Center ──
    Mod+Alt+C { center-column; }
    Mod+Alt+Shift+C { center-visible-columns; }

    // ── Column Operations ──
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ── Column / Window Consume ──
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    // Mod+Comma / Mod+Period are taken by noctalia; use Alt variants
    Mod+Alt+Comma  { consume-window-into-column; }
    Mod+Alt+Period { expel-window-from-column; }

    // Overview is available via hot-corner (top-left) or 4-finger swipe up
    // ── Inhibit / Power ──
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}

debug {
    honor-xdg-activation-with-invalid-serial
}
