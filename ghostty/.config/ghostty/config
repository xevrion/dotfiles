theme = catppuccin-mocha
font-size = 12
background-blur-radius = 20
mouse-hide-while-typing = true
window-decoration = true
background-opacity = 0.9
font-family = JetBrains Mono ExtraBold
keybind = ctrl+t=new_split:right
keybind = ctrl+z=close_surface
keybind = shift+enter=text:\x1b\r

clipboard-read = allow
clipboard-write = allow
copy-on-select = false
confirm-close-surface = false

# Machine-specific lines (shell path, shader path, font size) live in
# config.local next to this file. It is gitignored, one per machine.
# Templates: ~/dotfiles/macos/ghostty.config.local (Mac),
#            ~/dotfiles/macos/ghostty.config.local.linux (Fedora)
config-file = ?config.local
