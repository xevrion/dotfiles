struct mint {
    ll v; mint(ll v=0): v((v%MOD+MOD)%MOD){}
    mint operator+(mint o) const { return v+o.v >= MOD ? v+o.v-MOD : v+o.v; }
    mint operator-(mint o) const { return v-o.v < 0    ? v-o.v+MOD : v-o.v; }
    mint operator*(mint o) const { return v*o.v%MOD; }
