// BIT: 1-indexed, point update, range sum, O(log n)
struct BIT {
    int n; vector<ll> t;
    BIT(int n): n(n), t(n+1,0){}
    void update(int i, ll d){ for(;i<=n;i+=i&-i) t[i]+=d; }
    ll query(int i){ ll s=0; for(;i>0;i-=i&-i) s+=t[i]; return s; }
    ll query(int l, int r){ return query(r)-query(l-1); }
};

// SegTree: point update, range sum, [l,r) half-open
struct SegTree {
    int n; vector<ll> t;
    SegTree(int n): n(n), t(2*n, 0){}
    void build(vector<ll> &a){ fr(i,n) t[n+i]=a[i]; per(i,1,n) t[i]=t[2*i]+t[2*i+1]; }
    void update(int i, ll v){ for(t[i+=n]=v; i>>=1;) t[i]=t[2*i]+t[2*i+1]; }
    ll query(int l, int r){
        ll s=0; for(l+=n,r+=n;l<r;l>>=1,r>>=1){
            if(l&1) s+=t[l++]; if(r&1) s+=t[--r]; } return s; }
};

// DSU: tracks component count
struct DSU {
    vector<int> p, rnk; int comps;
    DSU(int n): p(n), rnk(n,0), comps(n){ iota(all(p),0); }
    int find(int x){ return p[x]==x ? x : p[x]=find(p[x]); }
    bool unite(int a, int b){
        a=find(a); b=find(b); if(a==b) return false;
        if(rnk[a]<rnk[b]) swap(a,b);
        p[b]=a; if(rnk[a]==rnk[b]) rnk[a]++; comps--; return true; }
    bool same(int a, int b){ return find(a)==find(b); }
};

// SparseTable: static range-min, build O(n log n), query O(1)
struct SparseTable {
    vector<vector<ll>> t; vector<int> lg;
    SparseTable(){}
    SparseTable(vector<ll> &a){
        int n=a.size(), LOG=__lg(n)+1;
        t.assign(LOG, vector<ll>(n)); lg.resize(n+1);
        t[0]=a; for(int i=2;i<=n;i++) lg[i]=lg[i/2]+1;
        for(int j=1;j<LOG;j++)
            for(int i=0;i+(1<<j)<=n;i++)
                t[j][i]=min(t[j-1][i], t[j-1][i+(1<<(j-1))]);
    }
    ll query(int l, int r){
        int k=lg[r-l+1]; return min(t[k][l], t[k][r-(1<<k)+1]); }
};

